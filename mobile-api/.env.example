NODE_ENV=production
PORT=4000
PUBLIC_BASE_URL=https://norea-mobile-api.onrender.com
APP_ORIGIN=https://norea-mobile-app.example
CORS_ORIGINS=https://norea-mobile-app.example,exp://127.0.0.1:8081

JWT_SECRET=replace-with-a-long-random-secret
MONGODB_URI=mongodb+srv://user:password@cluster.example/norea
MONGODB_DB=norea
MOBILE_ORDER_SOURCE=mobile
MOBILE_SEED_ON_EMPTY=false

MONGO_PRODUCTS_COLLECTION=products
MONGO_INVENTORY_COLLECTION=inventory
MONGO_CUSTOMERS_COLLECTION=customers
MONGO_ORDERS_COLLECTION=orders
MONGO_REVIEWS_COLLECTION=reviews
MONGO_PAYMENTS_COLLECTION=payments
MONGO_REFUNDS_COLLECTION=refunds
MONGO_PUSH_TOKENS_COLLECTION=pushTokens
MONGO_DISCOUNTS_COLLECTION=discounts

PRODUCT_ID_FIELD=id
PRODUCT_TITLE_FIELD=title
PRODUCT_CATEGORY_FIELD=category
PRODUCT_PRICE_FIELD=priceUsd
PRODUCT_SIZES_FIELD=sizes
PRODUCT_COLOURS_FIELD=colours
PRODUCT_RATING_FIELD=rating
PRODUCT_BADGE_FIELD=badge
PRODUCT_IMAGE_FIELD=imageUrl
PRODUCT_GALLERY_FIELD=gallery
PRODUCT_DESCRIPTION_FIELD=description
PRODUCT_ACTIVE_FIELD=active
PRODUCT_INVENTORY_FIELD=inventory

INVENTORY_PRODUCT_ID_FIELD=productId
INVENTORY_QUANTITY_FIELD=quantity

CUSTOMER_ID_FIELD=id
CUSTOMER_NAME_FIELD=name
CUSTOMER_EMAIL_FIELD=email
CUSTOMER_PHONE_FIELD=phone
CUSTOMER_ROLE_FIELD=role
CUSTOMER_PASSWORD_HASH_FIELD=passwordHash
CUSTOMER_ADDRESSES_FIELD=addresses
CUSTOMER_WISHLIST_FIELD=wishlist

ORDER_ID_FIELD=id
ORDER_CUSTOMER_ID_FIELD=userId
ORDER_STATUS_FIELD=status
ORDER_PAYMENT_STATUS_FIELD=paymentStatus

ADMIN_EMAIL=admin@norea.co.zw
ADMIN_PASSWORD=replace-before-production
ADMIN_EMAILS=admin@norea.co.zw
ADMIN_BOOTSTRAP_ENABLED=false

WHATSAPP_SUPPORT_NUMBER=263776678288
BANK_TRANSFER_DETAILS=Noréa Zimbabwe bank transfer details configured by operations
ZIPIT_DETAILS=Noréa ZIPIT merchant details configured by operations
ECOCASH_MERCHANT_CODE=Noréa EcoCash merchant code
ONEMONEY_MERCHANT_CODE=Noréa OneMoney merchant code

PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_RESULT_URL=https://norea-mobile-api.onrender.com/api/payments/paynow/result
PAYNOW_RETURN_URL=https://norea-mobile-api.onrender.com/api/payments/paynow/return
PAYMENT_RETURN_APP_URL=norea://orders
